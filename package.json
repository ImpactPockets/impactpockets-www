{
  "name": "impactpockets-www",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check": "astro check",
    "build:site": "node scripts/generate-image-dimensions.mjs && astro build",
    "sitemap:generate": "node scripts/generate-sitemap.mjs",
    "build": "npm run build:site && npm run sitemap:generate && npm run verify:sitemap",
    "preview": "astro preview",
    "test:unit": "vitest run",
    "deploy:staging": "npm run build && wrangler deploy",
    "deploy:production": "npm run build && wrangler deploy --env production",
    "verify:sitemap": "node scripts/run-go-for-launch.mjs verify-sitemap.mjs --dir=dist/client --site=https://www.impactpockets.com --sitemap=sitemap.xml",
    "verify:seo": "node scripts/run-go-for-launch.mjs verify-seo.mjs --dir=dist/client --site=https://www.impactpockets.com --trailing-slash=always",
    "verify:images": "node scripts/run-go-for-launch.mjs verify-images.mjs --dir=dist/client",
    "verify:brand": "node scripts/run-go-for-launch.mjs verify-brand-assets.mjs --config=brand-assets.config.mjs",
    "verify:site-health": "node scripts/run-go-for-launch.mjs verify-site-health.mjs --config=site-health.config.mjs",
    "verify:semantic-seo": "node scripts/run-go-for-launch.mjs verify-semantic-seo.mjs --config=semantic-seo.config.mjs",
    "verify:content-quality": "node scripts/run-go-for-launch.mjs verify-content-quality.mjs --config=content-quality.config.mjs",
    "verify:render": "node scripts/run-go-for-launch.mjs verify-render-sharpness.mjs --root=dist/client --output=artifacts/render-sharpness-report.json",
    "verify:side-navigation": "node scripts/run-go-for-launch.mjs verify-side-navigation.mjs --root=dist/client --output=artifacts/side-navigation-report.json",
    "verify:design": "node scripts/run-go-for-launch.mjs run-design-gate.mjs --config=design-gate.config.mjs",
    "test:browser": "playwright test",
    "verify": "npm run check && npm run test:unit && npm run build && npm run verify:seo && npm run verify:images && npm run verify:brand && npm run verify:site-health && npm run verify:semantic-seo && npm run verify:content-quality && npm run verify:render && npm run verify:side-navigation && npm run verify:design && npm run test:browser"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/cloudflare": "^14.1.4",
    "@cloudflare/workers-types": "^5.20260722.1",
    "@playwright/test": "1.61.1",
    "@types/node": "^26.1.1",
    "astro": "7.1.3",
    "sharp": "^0.35.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.113.0"
  }
}
